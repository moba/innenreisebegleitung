{{- /* Vorlage für die .htaccess im Wurzelverzeichnis der Auslieferung.

     Liegt in assets/ statt in static/, weil zwei der Regeln von der Adresse
     abhängen und die sich je Umgebung unterscheidet. Erzeugt wird die Datei
     in layouts/index.html, genau einmal pro Bau.

     WICHTIG: Der Hostname darf in keiner RewriteCond wörtlich auftauchen.
     Bei berührungen.com steht im Host-Header der Anfrage die Punycode-Form
     xn--berhrungen-ceb.com; ein Vergleich gegen "berührungen.com" träfe nie
     zu, und die daran hängende Umleitung liefe endlos. Die Regeln unten
     kommen deshalb ohne Hostnamen aus und arbeiten nur mit %{HTTP_HOST}. */ -}}
{{- $host := (urls.Parse .Site.BaseURL).Host -}}
{{- $wantsWww := hasPrefix $host "www." -}}
# Erzeugt aus assets/htaccess.tmpl -- Änderungen dort vornehmen, nicht hier.
# Umgebung: {{ hugo.Environment }} ({{ $host }})

RewriteEngine On
RewriteBase /

ErrorDocument 404 /404.html

# Der Server schickte bisher "Content-Type: text/html" ohne charset. Wer sich
# darauf verlässt statt auf das <meta charset> im Dokument -- Vorschau-Bots,
# Feedleser, ältere Parser -- las "Über" als Latin-1.
AddDefaultCharset UTF-8

# ---------------------------------------------------------------------------
# Falsch kodierter Hostname von berührungen.com
#
# LinkedIn wandelt den Umlaut beim Abruf nicht in Punycode um, sondern
# kodiert ihn prozentweise und schickt "Host: ber%C3%BChrungen.com". Zu
# diesem Namen gibt es keinen vhost, die Anfrage landet deshalb in der
# Auslieferung der Hauptdomain, und LiteSpeed schickt sie von dort mit 307
# auf www.innenreisebegleitung.de weiter. Die Vorschau nennt seitdem die
# falsche Adresse, obwohl der geteilte Verweis auf berührungen.com zeigt.
#
# Ohne diese Regel greift in der Auslieferung innenreise zusätzlich die
# www-Umleitung weiter unten und zeigt auf www.ber%C3%BChrungen.com -- einen
# Namen, den es genauso wenig gibt.
#
# Kein Widerspruch zur Warnung am Kopf der Vorlage: verboten ist der
# Vergleich gegen den *echten* Hostnamen, der als Punycode ankommt. Geprüft
# wird hier die kaputte Schreibweise, und das Ziel der Umleitung trifft das
# Muster nie -- sie kann also nicht kreisen.
#
# Welche Bytes genau ankommen, wurde gemessen: eine vorübergehende Regel
# leitete jeden unbekannten Host auf "/?host=%{HTTP_HOST}" um, so dass der
# Post Inspector die Zeichenfolge in seiner Weiterleitungskette anzeigte.
# LinkedIn schickt danach "ber%C3%BChrungen.com" mit echten Prozentzeichen,
# nicht die rohen UTF-8-Bytes des Umlauts. Der Server schreibt den Host-Header
# zusätzlich klein.
#
# Das Muster nennt die Zeichen des Umlauts nicht, sondern zählt nur, wie
# viele an seiner Stelle stehen dürfen: ".{1,6}" trifft jede Schreibweise --
# "%C3%BC" (sechs Zeichen), die zwei Bytes C3 BC, und den Umlaut als ein
# einzelnes Zeichen, falls die Regex-Maschine im UTF-8-Modus läuft und einen
# Punkt pro Zeichen statt pro Byte zählt.
#
# Diese Gleichgültigkeit ist der Punkt. Eine Fassung, die auf "%C3%BC" bzw.
# zwei Bytes genau passte, traf am Server nicht zu, obwohl dieselbe Regex
# gegen dieselben Eingaben lokal zutraf -- welche Maschine mit welchen
# Einstellungen dort arbeitet, ist von außen nicht feststellbar. Das Muster
# oben muss das nicht wissen.
#
# Ein literales % wäre ohnehin heikel: es grenzt in einer CondPattern an die
# Ersetzungssyntax von mod_rewrite. Und ein rohes ü in dieser Datei hinge
# daran, dass jedes Werkzeug auf dem Weg zum Server die Kodierung unangetastet
# lässt.
#
# Dass dadurch auch Namen wie "berXYhrungen.com" zutreffen, ist folgenlos:
# sie gehören ebenso wenig hierher und landen auf derselben Adresse.
#
# Der Schwanz "\.?(:[0-9]+)?" ist Vorsorge, keine Reaktion: %{HTTP_HOST}
# enthält den Host-Header so, wie er ankommt, und der trägt je nach Abrufer
# noch den Port ("berührungen.com:443") oder den abschließenden Punkt der
# absoluten DNS-Notation ("berührungen.com."). LinkedIn schickt beides nicht,
# andere Vorschau-Dienste können es. Ein Muster, das strikt auf ".com" endet,
# liefe an ihnen vorbei.
RewriteCond %{HTTP_HOST} ^(www\.)?ber.{1,6}hrungen\.com\.?(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://xn--berhrungen-ceb.com/$1 [R=301,L]

# ---------------------------------------------------------------------------
# Auf die kanonische Schreibweise der Adresse umleiten.
{{ if $wantsWww }}# Diese Auslieferung läuft mit www, also die Form ohne www dorthin schicken.
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
{{ else }}# Diese Auslieferung läuft ohne www, also das www entfernen.
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
{{ end }}
# %{HTTP_HOST} statt eines festen Namens: so gilt die Regel für beide
# Auslieferungen und kann nicht auf die jeweils andere Adresse zeigen.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---------------------------------------------------------------------------
# Adressen, die es früher gab.
#
# Bis zum Umstieg auf rsync --delete (September 2026) blieb auf dem Server
# alles liegen, was dort je hochgeladen wurde -- auch Seiten unter ihrer alten
# Adresse. Beide unten waren dadurch über ein Jahr lang parallel erreichbar:
#
#   /über/    Slug der Über-Seite von Mai 2025 bis Juli 2026 (Commit 2162119
#             änderte ihn auf "ueber")
#   /contact/ hieß die Kontaktseite bis Mai 2026 (Commit d1866f4 benannte
#             content/contact.md in kontakt.md um)
#
# %{REQUEST_URI} statt des Musters der RewriteRule, weil dort der Pfad schon
# dekodiert ankommt und der Umlaut je nach Server unterschiedlich geschrieben
# wird.
# ---------------------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/(%C3%BCber|über)/?$ [NC]
RewriteRule ^ /ueber/ [R=301,L]

RewriteRule ^contact/?$ /kontakt/ [R=301,L]

# Die Präsenz-Seite ist im September 2026 in die Arbeitsweise-Seite gewandert
# und steht dort als eigener Abschnitt. Das Sprungziel ist der Anker an der
# Überschrift (content/arbeitsweise.md: "{#praesenz}" bzw. "{#presence}").
#
# NE (noescape) ist hier zwingend: ohne das Flag schreibt Apache die Raute
# als %23 in den Location-Header, und der Browser landet auf einer Adresse,
# die es nicht gibt, statt auf dem Abschnitt.
RewriteRule ^praesenz/?$ /arbeitsweise/#praesenz [R=301,L,NE]
RewriteRule ^en/presence/?$ /en/principles/#presence [R=301,L,NE]

# Die englische Fassung der Berührungs-Gruppe hieß bis September 2026
# „Touches in Silence". „Silence" heißt im Englischen nur, dass niemand
# spricht; gemeint ist aber der Zustand, den Boxhall „stillness" nennt --
# so heißt auch seine eigene Website. Die deutsche Adresse
# (/gruppen/beruehrungen-in-stille/) bleibt unverändert, weil „Stille" im
# Deutschen beides abdeckt.
RewriteRule ^en/groups/touches-in-silence/?$ /en/groups/touches-in-stillness/ [R=301,L]

ExpiresActive On
ExpiresByType font/woff2  "access plus 1 year"
ExpiresByType image/* "access plus 4 months"

Header set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; default-src 'none'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self';"

Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "no-referrer"

Header set X-Robots-Tag "noimageindex"

# webp/avif ergänzt: seit der Bildaufbereitung durch Hugo werden die Fotos
# überwiegend als WebP ausgeliefert und fielen sonst aus dieser Regel heraus.
<FilesMatch "\.(png|jpg|jpeg|webp|avif|svg)$">
	Header set X-Robots-Tag "noindex, noarchive, nosnippet"
</FilesMatch>

# Kontakt- und Datenschutzseiten gehören nicht in den Suchindex.
# <FilesMatch> hilft hier nicht: die Adressen sind Verzeichnisse und landen
# alle auf index.html.
# Deshalb über eine Umgebungsvariable am Request-Pfad. `always`, damit der
# Header auch an der 301 von /contact/ hängt.
#
# Dass static/robots.txt dieselben Adressen zusätzlich per Disallow sperrt,
# ist Absicht und kein Versehen -- beides zu setzen wird gelegentlich als
# Widerspruch gemeldet, ist hier aber gewollt:
#
#   Disallow  verhindert, dass der Inhalt überhaupt abgerufen wird. Die
#             Adresse selbst darf in Ergebnissen auftauchen, dann ohne
#             Textauszug. Genau das ist hier erwünscht.
#   noindex   greift dort, wo Disallow nicht gilt: bei Suchdiensten, die
#             robots.txt ignorieren aber den Header beachten, und falls die
#             Disallow-Zeilen irgendwann fallen.
#
# Der Header ist also Absicherung, nicht Dopplung. Bitte nicht "aufräumen".
#
# Aus dem Sitemap sind die gesperrten Seiten dagegen heraus (sitemap.disable
# im Front Matter von kontakt.md, kontakt.en.md, datenschutz.md,
# datenschutz.en.md): eine Adresse einzureichen und gleichzeitig das Abrufen
# zu verbieten, meldet die Search Console zu Recht. Es sind dieselben vier
# Adressen wie in der Regel unten.
SetEnvIf Request_URI "^/(kontakt|en/contact|datenschutz|en/privacy)/?$" NOINDEX_PAGE
Header always set X-Robots-Tag "noindex" env=NOINDEX_PAGE

# ---------------------------------------------------------------------------
# Cache-Control
#
# Hugo hängt an CSS und JS den SHA-256 ihres Inhalts (fingerprint) und an die
# skalierten Bildfassungen den Verarbeitungs-Hash (see_hu_4e3271702b306e7c.webp).
# Diese Namen ändern sich mit jeder Änderung des Inhalts, die Dateien können
# also dauerhaft im Browser bleiben. Ohne diese Regeln liefert der Server für
# CSS/JS max-age=604800 -- also wöchentlich ein Revalidierungs-Roundtrip pro
# Datei, obwohl sich unter der Adresse nie etwas ändern kann.
#
# Die Header-Zeilen stehen bewusst nach ExpiresByType weiter oben: mod_headers
# läuft später und überschreibt das von mod_expires gesetzte max-age.
# ---------------------------------------------------------------------------
<FilesMatch "\.[0-9a-f]{64}\.(css|js)$">
	Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

<FilesMatch "_hu_[0-9a-f]+\.(jpg|jpeg|png|webp|avif|gif)$">
	Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML dagegen liegt unter stabilen Adressen und muss bei jedem Aufruf
# nachgefragt werden; bisher gab der Server dafür gar kein Cache-Control mit,
# der Browser hat die Frist also geraten.
<FilesMatch "\.html$">
	Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php72” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php72 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
